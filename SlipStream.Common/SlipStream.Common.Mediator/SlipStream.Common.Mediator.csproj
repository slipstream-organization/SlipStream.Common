        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>SlipStream.Common</RootNamespace>
        <RepositoryUrl>https://github.com/slipstream-organization/SlipStream.Common</RepositoryUrl>
